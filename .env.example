# Glass Bank - example environment.
# Every variable parsed by src/config/index.ts appears here with its default (table in docs/DEPLOYMENT.md).
# Copy to .env for local runs (.env is git-ignored). Real values come from Secret Manager in the cloud.
# FEATURE_FLAGS and PUBLIC_HOSTS use ';' as the separator because `gcloud run deploy --set-env-vars`
# splits on commas (see docs/DEPLOYMENT.md).

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Port the process listens on; Cloud Run injects 8080. The app always binds 0.0.0.0 (invariant 12).
PORT=8080
# Log verbosity: debug | info | warn | error.
LOG_LEVEL=info

# --- Public identity ---------------------------------------------------------
# Fallback canonical MCP base URL when the request Host is not listed in PUBLIC_HOSTS; also used for pairing URLs.
PUBLIC_BASE_URL=http://localhost:8080
# ';'-separated list of every hostname this service answers on (both run.app forms in the cloud, the tunnel host locally).
PUBLIC_HOSTS=localhost:8080
# Browser Origin policy: log-only (current) or allowlist (production target, once real claude.ai Origin values are recorded).
ORIGIN_POLICY=log-only
# ';'-separated feature flags. Write tools are on by default (Decision D-3).
FEATURE_FLAGS=writes;transfers
# Serve the sign-in-free public lane at /public/mcp: the profile, products, prices and branches (D-26).
PUBLIC_MCP=true

# --- Secrets (never commit real values) --------------------------------------
# HS256 key for codes, access, refresh, viewer, txn and login JWTs. Required when NODE_ENV=production.
# In the cloud: Secret Manager mcp-bank-oauth-signing-key.
OAUTH_SIGNING_KEY=dev-only-insecure-signing-key-change-me-32+
# Dashboard observer-mode admin token. In the cloud: Secret Manager mcp-bank-admin-token.
XRAY_ADMIN_TOKEN=dev-only-insecure-admin-token-change-me-32+

# --- X-ray event log ---------------------------------------------------------
# SQLite file for the append-only event log (WAL). /tmp is memory-backed on Cloud Run gen2.
XRAY_DB_PATH=/tmp/xray.sqlite
# Retention job deletes events older than this many hours.
XRAY_RETENTION_HOURS=72
# Hard row cap on the event log. Time-based retention alone is not a memory bound, and /tmp is
# memory-backed on Cloud Run gen2, so the retention job also trims to this and reclaims the pages.
XRAY_MAX_LOG_ROWS=200000
# Byte cap on the event log (v0.9, D-28). Events are stored whole - raw headers and bodies
# included, never truncated - so past this the oldest whole events go, on every write batch.
XRAY_MAX_LOG_BYTES=268435456
# Path prefixes the catch-all http.request observer leaves out (';'-separated): the dashboard's
# own traffic and the uptime check. `none` records every path.
XRAY_CAPTURE_SKIP_PATHS=/xray;/health;/healthz
# A request arriving after this much silence for a grant starts a new X-ray session (xs).
XS_IDLE_GAP_MINUTES=15
# Concurrent dashboard SSE streams one login may hold open; further ones get 429 + Retry-After.
XRAY_MAX_STREAMS_PER_LOGIN=4
# Concurrent dashboard SSE streams the whole process may hold open (Cloud Run allows 250 requests).
XRAY_MAX_STREAMS=64
# Concurrent public-lane streams (/xray/?lane=public, no cookie), every reader together; inside XRAY_MAX_STREAMS.
XRAY_MAX_PUBLIC_STREAMS=16

# --- Auth storage ------------------------------------------------------------
# SQLite file holding the dynamic client registration table.
AUTH_DB_PATH=/tmp/auth.sqlite
# Bounded LRU of dynamically registered OAuth clients.
MAX_DCR_CLIENTS=1000
# Advertise client_id_metadata_document_supported. Stays false until DCR is observed working (A-37).
CIMD_ENABLED=false

# --- Web Bot Auth (v0.10, D-29) ------------------------------------------------
# Verify RFC 9421 signatures tagged web-bot-auth against the agent's published key directory.
# A verdict is recorded on http.request.signature and never changes an answer.
BOT_AUTH_VERIFY=true
# off | advertise. advertise adds Accept-Signature to /mcp and /public/mcp responses.
BOT_AUTH_CHALLENGE=off
# Directory cache lifetime when the directory sends no Cache-Control max-age (60..86400).
BOT_AUTH_DIRECTORY_TTL_S=3600
BOT_AUTH_FETCH_TIMEOUT_MS=3000
# Agents whose keys are cached at once, and directory fetches allowed per hour (invariant 14).
BOT_AUTH_MAX_DIRECTORIES=100
BOT_AUTH_MAX_FETCHES_PER_HOUR=60
# Development only: accept http:// and loopback directories (a local demo signer). Refused in production.
BOT_AUTH_ALLOW_LOOPBACK=false

# --- ETL / scratch SQL guard -------------------------------------------------
# Maximum scratch tables a single grant may hold.
MAX_TABLES_PER_GRANT=10
# Global cap on scratch :memory: databases before LRU eviction.
MAX_SCRATCH_DBS=200
# Hard row cap on any execute_query result.
MAX_QUERY_ROWS=100
# Idle time after which a scratch table is evicted.
TABLE_TTL_MINUTES=30
# CPU budget for one model-authored query, enforced by SIGKILL of the forked SQL runner (ADR-9, A-39):
# worker.terminate() cannot stop native SQLite.
QUERY_TIMEOUT_MS=2000
# Maximum ETL operations running concurrently.
MAX_CONCURRENT_ETL_OPS=2
# Size of the forked SQL runner pool (ADR-9).
ETL_WORKER_POOL_SIZE=4
# Hard query timeouts one grant may cause before its queries are refused up front. A hard timeout
# SIGKILLs a shared runner and its co-tenant grants lose their scratch tables, so this bounds how
# much damage one caller can do.
MAX_QUERY_TIMEOUTS=3

# --- Bank core caps ----------------------------------------------------------
# Bounded LRU of materialised personas.
MAX_MATERIALISED_PERSONAS=200
# Bounded LRU of per-login copy-on-write persona overlays (ADR-15).
MAX_PERSONA_OVERLAYS=1000
# Idle time after which a persona overlay is reset to the shared immutable seed.
PERSONA_OVERLAY_TTL_HOURS=24

# --- Rate limits (counts; the window is part of the name) --------------------
# Dynamic client registration attempts per IP per hour.
RATE_LIMIT_IP_REGISTER=60
# /authorize requests per IP per 15 minutes (sized for Anthropic's shared 160.79.104.0/21 egress).
RATE_LIMIT_IP_AUTHORIZE=300
# /token and /revoke requests per IP per 15 minutes. The un-forgeable half of the /token limit:
# RATE_LIMIT_CLIENT_TOKEN keys on the client_id in the request body, which a caller can rotate.
RATE_LIMIT_IP_TOKEN=300
# /consent submissions per IP per 15 minutes.
RATE_LIMIT_IP_CONSENT=60
# Failed pairing-code exchanges per IP per minute.
RATE_LIMIT_IP_PAIR_FAILURES=5
# /token requests per client_id or grant_id per 15 minutes.
RATE_LIMIT_CLIENT_TOKEN=120
# tools/call requests per grant per minute.
RATE_LIMIT_GRANT_TOOL_CALLS=120
# New grants per login_id per day.
RATE_LIMIT_LOGIN_GRANTS=20
# Public lane tools/call per IP prefix per minute (claude.ai users share Anthropic's egress, so keep it generous).
RATE_LIMIT_PUBLIC_IP_TOOL_CALLS=60
# Public lane tools/call per minute across every anonymous visitor: protects the one instance the signed-in demo shares.
RATE_LIMIT_PUBLIC_TOOL_CALLS=600

# --- Optional (backlog) -----------------------------------------------------
# GCS bucket for periodic event-log snapshots (Decision D-6). Empty disables snapshots.
SNAPSHOT_BUCKET=
